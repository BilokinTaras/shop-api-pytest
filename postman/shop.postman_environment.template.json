{
  "name": "shop-sut (local)",
  "values": [
    {
      "key": "base_url",
      "value": "http://localhost:9000",
      "enabled": true
    },
    {
      "key": "publishable_key",
      "value": "<SUT_PUBLISHABLE_KEY from ../shop-sut/.generated/sut.env>",
      "enabled": true
    },
    {
      "key": "region_id",
      "value": "<SUT_REGION_ID>",
      "enabled": true
    },
    {
      "key": "admin_email",
      "value": "<SUT_ADMIN_EMAIL>",
      "enabled": true
    },
    {
      "key": "admin_password",
      "value": "<SUT_ADMIN_PASSWORD>",
      "type": "secret",
      "enabled": true
    }
  ]
}
